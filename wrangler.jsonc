{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xinge-broadcast-bot",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "XingeContainer",
      "image": "./Dockerfile",
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "XINGE_CONTAINER",
        "class_name": "XingeContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["XingeContainer"]
    }
  ]
}
